diff --git a/scripts/guap_labflow_sync.py b/scripts/guap_labflow_sync.py
index 22143a9..805d684 100755
--- a/scripts/guap_labflow_sync.py
+++ b/scripts/guap_labflow_sync.py
@@ -594,0 +595,14 @@ def run_once(
+    def fetch_with_current_cookie(url: str, _snapshot: str) -> dict[str, Any]:
+        # CLI reads may have restored the application session. Never reuse the
+        # pre-query credential snapshot for material downloads.
+        fd = os.open(cookie_path, os.O_RDONLY | os.O_NOFOLLOW)
+        with os.fdopen(fd, 'r', encoding='utf-8') as handle:
+            info = os.fstat(handle.fileno())
+            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                    or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
+                raise RuntimeError('An owned mode-0600 cookie file is required')
+            current = handle.read(131073).strip()
+            if not current or len(current) > 131072 or '\r' in current or '\n' in current:
+                raise RuntimeError('Invalid current cookie snapshot')
+        return fetch_source(url, current)
+
@@ -600 +614 @@ def run_once(
-        fetch_source=fetch_source,
+        fetch_source=fetch_with_current_cookie,
