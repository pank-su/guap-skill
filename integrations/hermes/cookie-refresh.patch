+                    cookie.write_text('PHPSESSID=renewed-example')
+                records = [{'subject':'Механика','name':'Методичка','urls':['/inside/student/materials/example/download']}] if command == 'materials' else []
+                return SimpleNamespace(returncode=0, stdout=json.dumps(records), stderr='')
+            def fetch(url, value):
+                received.append(value)
+                return {'filename':'example.pdf','data':b'PDF','kind':'file'}
+            module.run_once(permit_path=permit, root=temp / 'GUAP', state_path=temp / 'state.json',
+                            cookie_path=cookie, guap_cli=Path('/safe/guap.py'), runner=runner, fetch_source=fetch)
+            self.assertEqual(received, ['PHPSESSID=renewed-example'])
